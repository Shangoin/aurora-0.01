# ============================================================
# AURORA 0.01% — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ─── AI Cascade (Gemini → Grok → OpenAI — use all 3 for max resilience) ──────
GEMINI_API_KEY=AIzaS...        # Primary. ~$0.075/M tokens. Get: ai.google.dev
GROK_API_KEY=xai-...           # Backup. Get: console.x.ai
OPENAI_API_KEY=sk-proj-...     # Fallback. Get: platform.openai.com
ANTHROPIC_API_KEY=sk-ant-...   # For critique (quality-critical). Get: console.anthropic.com

# ─── Vapi (Voice AI) ─────────────────────────────────────────────────────────
# Create at: dashboard.vapi.ai
VAPI_API_KEY=...               # Your Vapi private key
VAPI_ASSISTANT_ID=...          # Your assistant ID (created at dashboard.vapi.ai)
VAPI_PHONE_NUMBER_ID=...       # Your Vapi outbound phone number ID

# ─── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://your-backend.onrender.com
WEBHOOK_SECRET=choose-a-strong-random-secret-here
ADMIN_SECRET=another-strong-secret-for-admin-endpoints

# ─── Email (via Resend SMTP) ──────────────────────────────────────────────────
RESEND_API_KEY=re_...           # Get: resend.com (free 3,000 emails/month)
FROM_EMAIL=aurora@yourdomain.com

# ─── Slack (optional — for notifications) ────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── Landing Page ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
