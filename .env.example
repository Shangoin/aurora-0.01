# ============================================================
# AURORA 1.0 — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ─── AI Cascade ₹0 Stack (6 providers — all free / near-free) ────────────────
# Provider order: Gemini → Groq → Cerebras → Mistral → DeepSeek → GPT-4o-mini
GEMINI_API_KEY=AIzaS...          # PRIMARY.  Free 15 req/min, 1M ctx. aistudio.google.com/apikey
GROK_API_KEY=gsk_...             # SPEED.    Free 6k req/day, 128K ctx. console.groq.com
CEREBRAS_API_KEY=csk-...         # TOKENS.   Free 1M tokens/day. inference.cerebras.ai
MISTRAL_API_KEY=...              # MULTILINGUAL. Free 1B tokens/mo. console.mistral.ai
OPENROUTER_API_KEY=sk-or-...     # REASONING. Free 50 req/day (DeepSeek V3). openrouter.ai
# OPENAI_API_KEY=sk-proj-...     # LAST RESORT. ~$0.15/M tokens. platform.openai.com

# ─── Vapi (Voice AI) — Geo-Routing (4 Twilio numbers) ────────────────────────
# Create numbers at: dashboard.vapi.ai → Phone Numbers → Import from Twilio
VAPI_API_KEY=...                 # Your Vapi private key
VAPI_ASSISTANT_ID=...            # ARIA assistant ID (dashboard.vapi.ai)
VAPI_PHONE_NUMBER_ID=...         # Default/Global outbound number
VAPI_PHONE_NUMBER_ID_IN=...      # India (Mumbai) — +91 leads get this local CID
VAPI_PHONE_NUMBER_ID_US=...      # US/CA (SF/NY) — +1 leads get this local CID
VAPI_PHONE_NUMBER_ID_UK=...      # UK (London) — +44 leads get this local CID
VAPI_PHONE_NUMBER_ID_GLOBAL=...  # AU/SG/Other — any other country code

# ─── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://api.shango.in
WEBHOOK_SECRET=choose-a-strong-random-secret-here
ADMIN_SECRET=another-strong-secret-for-admin-endpoints

# ─── Email (via Resend SMTP) ──────────────────────────────────────────────────
RESEND_API_KEY=re_...            # Get: resend.com (free 3,000 emails/month)
FROM_EMAIL=team@shango.in

# ─── Brevo / Sendinblue (Lead Nurture Emails) ────────────────────────────────
BREVO_API_KEY=xkeysib-...        # Get: app.brevo.com → SMTP & API → API Keys
FROM_NAME=Shango Revenue Systems

# ─── Slack (optional — for notifications) ────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://shango.in,https://www.shango.in,https://dashboard.shango.in

# ─── Landing Page ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=https://api.shango.in
